{
  "name": "muse-video-bridge",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri",
    "format": "prettier --write src tests *.json *.ts *.js index.html",
    "format:check": "prettier --check src tests *.json *.ts *.js index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "playwright-core": "1.61.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
